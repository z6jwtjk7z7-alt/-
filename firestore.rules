rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /vocabPushUsers/{userId} {
      allow read, write: if request.auth == null
        && userId.matches('^[A-Za-z0-9_-]{20,80}$')
        && request.resource.data.keys().hasOnly([
          'token','enabled','reviewTime','dueCount','nextNotificationAt','updatedAt','appUrl','platform'
        ]);
    }
  }
}
